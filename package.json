{
  "name": "nestjs-task-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal production-ready async gray data import platform with NestJS + BullMQ + TableStore",
  "scripts": {
    "build": "nest build",
    "start:api": "nest start api --watch",
    "start:worker": "nest start worker --watch",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:worker:prod": "node dist/apps/worker/main.js",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "echo \"No tests configured\""
